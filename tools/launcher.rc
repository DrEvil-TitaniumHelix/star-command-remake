#include <winres.h>
#include "version.h"
1 RT_MANIFEST "launcher.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_N
PRODUCTVERSION VER_N
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
BLOCK "StringFileInfo"
BEGIN
BLOCK "040904b0"
BEGIN
VALUE "CompanyName", "Titanium Helix Games"
VALUE "FileDescription", "Star Command Remake launcher"
VALUE "FileVersion", VER_S
VALUE "InternalName", "StarCommand"
VALUE "LegalCopyright", "Titanium Helix Games"
VALUE "OriginalFilename", "StarCommand.exe"
VALUE "ProductName", "Star Command Remake"
VALUE "ProductVersion", VER_S
END
END
BLOCK "VarFileInfo"
BEGIN
VALUE "Translation", 0x409, 1200
END
END
